  status               String   @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, ARCHIVED
  generatedById        Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
