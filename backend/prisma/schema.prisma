}

model AILearningIntervention {
  id                 Int       @id @default(autoincrement())
  tenantId           Int
  studentId          Int
  assignedTeacherId  Int?
  title              String
  triggerReason      String    // ATTENDANCE_DROP, GRADE_DROP, MISSING_ASSIGNMENTS, ACADEMIC_RISK
  severity           String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  actionStrategy     String    // 1-on-1 Remedial Session, Parent Conference, Peer Study Group, Tutoring
  actionNotes        String?   @db.Text
  status             String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, DISMISSED
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

