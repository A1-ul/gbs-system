  zone         CampusZone @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  metric_type  String     @db.VarChar(50)
  metric_value Decimal    @db.Decimal(10, 2)
  unit         String?    @db.VarChar(20)
  recorded_at  DateTime   @default(now())

  @@index([zone_id])
  @@map("campus_telemetry_logs")
}

// ==================================================
// SMART CCTV & SECURITY GATE EVENTS
// ==================================================

model CctvStream {
  id            Int       @id @default(autoincrement())
  tenant_id     Int       @default(1)
  camera_code   String    @unique @db.VarChar(50)
  camera_name   String    @db.VarChar(150)
  location      String    @db.VarChar(150)
  rtsp_endpoint String    @db.VarChar(255)
  resolution    String?   @default("1080p FHD") @db.VarChar(50)
  fps           Int       @default(30)
  status        String?   @default("ONLINE") @db.VarChar(30)
  ai_enabled    Boolean   @default(true)
  storage_days  Int       @default(30)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  @@index([tenant_id])
  @@map("cctv_streams")
}

model SecurityGateEvent {
  id             Int       @id @default(autoincrement())
  tenant_id      Int       @default(1)
  gate_name      String    @db.VarChar(100)
  event_type     String    @db.VarChar(50)
  person_name    String    @db.VarChar(150)
  person_role    String    @db.VarChar(50)
  badge_id       String?   @db.VarChar(50)
  facial_match   Boolean   @default(true)
  confidence_pct Decimal   @default(99.4) @db.Decimal(5, 2)
  status         String?   @default("GRANTED") @db.VarChar(30)
  event_time     DateTime  @default(now())

  @@index([tenant_id])
  @@map("security_gate_events")
}

// ==================================================
// REGIONAL SHARDING & DR FAILOVER
// ==================================================

model ShardRegistry {
  id                  Int       @id @default(autoincrement())
  shard_key           String    @unique @db.VarChar(64)
  name                String    @db.VarChar(255)
  region              String    @db.VarChar(64)
  host                String    @db.VarChar(255)
  port                Int       @default(5432)
  database_name       String    @default("gbs_system") @db.VarChar(128)
  allocated_tenants   Int?      @default(1)
  max_tenants         Int?      @default(50)
  storage_capacity_gb Decimal?  @default(500.00) @db.Decimal(10, 2)
  storage_used_gb     Decimal?  @default(42.50) @db.Decimal(10, 2)
  avg_latency_ms      Decimal?  @default(4.20) @db.Decimal(8, 2)
  status              String?   @default("ONLINE") @db.VarChar(32)
  is_primary          Boolean?  @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt

  @@map("shard_registry")
}

model ReplicaStatus {
  id                 Int       @id @default(autoincrement())
  replica_name       String    @unique @db.VarChar(128)
  role               String    @db.VarChar(32)
  endpoint           String    @db.VarChar(255)
  region             String    @db.VarChar(64)
  replication_lag_ms Decimal?  @default(0.0) @db.Decimal(8, 2)
  sync_state         String?   @default("STREAMING") @db.VarChar(32)
  wal_lsn            String?   @default("0/1F88420") @db.VarChar(64)
  health_score       Int?      @default(100)
  is_healthy         Boolean?  @default(true)
  last_heartbeat     DateTime  @default(now())
  created_at         DateTime  @default(now())

  @@map("replica_status")
}

model DrFailoverLog {
  id                Int       @id @default(autoincrement())
  drill_id          String    @unique @db.VarChar(64)
  trigger_type      String    @db.VarChar(32)
  source_shard      String    @db.VarChar(64)
  target_shard      String    @db.VarChar(64)
  rpo_seconds       Decimal?  @default(0.0) @db.Decimal(8, 2)
  rto_minutes       Decimal?  @default(1.5) @db.Decimal(8, 2)
  status            String?   @default("COMPLETED") @db.VarChar(32)
  initiated_by      String    @default("Developer Root / Sentinel") @db.VarChar(128)
  verification_hash String    @db.VarChar(128)
  notes             String?
  created_at        DateTime  @default(now())

  @@map("dr_failover_logs")
}

