model InstitutionRegistration {
  id                      Int       @id @default(autoincrement())
  tenantId                Int?
  tenant                  Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Tenant Identification System
  tenantUid               String    @unique // e.g. TEN-2026-000145
  tenantCode              String    @unique // e.g. GBS-ACC-0145
  institutionId           String    @unique // e.g. INS-2026-001245
  subscriptionId          String    @unique // e.g. SUB-2026-000145

  // Institution Information
  institutionName         String
  institutionType         String    // K-12 School, International Academy, University / College, Boarding School, Vocational Institute
  country                 String
  region                  String
  city                    String
  physicalAddress         String
  gpsLocation             String?
  officialEmail           String
  officialPhone           String
  website                 String?
  registrationNumber      String
  businessLicenseNumber   String
  taxIdentificationNumber String
  institutionLogo         String?

  // Authorized Representative
  repFullName             String
  repPosition             String
  repEmail                String
  repPhone                String

  // Administrator Information
  adminName               String
  adminEmail              String
  adminPhone              String
  adminPasswordHash       String

  // Compliance
  termsAccepted           Boolean   @default(false)
  privacyAccepted         Boolean   @default(false)
  dataProcessingConsent   Boolean   @default(false)

  // Headcount & Subscription Plan Formula
  totalStudentsEnrolled   Int?      @default(0)
  perStudentRate          Float?    @default(5.0)
  calculatedBaseFee       Float?    @default(0.0)
  subscriptionPlan        String?   @default("1_MONTH_TRIAL")
  paymentAmount           String?   @default("0")
  momoTxnId               String?   @default("FREE_TRIAL_AUTO")
  hasUsedTrial            Boolean   @default(false)
  isApproved              Boolean   @default(false)

  // Status & Lifecycle
  status                  String    @default("PENDING") // PENDING, VERIFICATION_REQUIRED, APPROVED, PROVISIONING, ACTIVE_TRIAL, REJECTED
  rejectionReason         String?
  reviewNotes             String?
  approvedBy              Int?
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status])
  @@index([officialEmail])
  @@index([tenantCode])
  @@map("institution_registrations")
}

