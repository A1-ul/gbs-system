// ==================================================
// ENTERPRISE FINANCE & FEE MANAGEMENT (Blueprint Box 14 & 15)
// ==================================================

model FeeStructure {
  id                Int              @id @default(autoincrement())
  tenantId          Int
  code              String           // e.g. TUITION_GRADE_10, LAB_FEE_SCIENCE, TRANSPORT_ZONE_A
  name              String
  category          String           @default("TUITION") // TUITION, LAB, TRANSPORT, BOARDING, EXAM, ACTIVITY
  academicYear      String           @default("2026-2027")
  term              String           @default("Term 1")
  gradeLevel        Int?
  amount            Float
  currency          String           @default("USD")
  dueDate           DateTime?
  lateFeePercentage Float            @default(5.0)
  isMandatory       Boolean          @default(true)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  invoices          StudentInvoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
  @@map("fee_structures")
}

model StudentInvoice {
  id             Int                  @id @default(autoincrement())
  tenantId       Int
  invoiceNumber  String               // INV-2026-XXXXX
  studentId      Int
  feeStructureId Int?
  feeStructure   FeeStructure?        @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  title          String
  academicTerm   String               @default("2026-2027 Term 1")
  amount         Float
  discountAmount Float                @default(0.0)
  netAmount      Float
  paidAmount     Float                @default(0.0)
  balanceDue     Float
  dueDate        DateTime
  status         String               @default("DUE") // DUE, PARTIAL, PAID, OVERDUE, CANCELLED
  notes          String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  payments       PaymentTransaction[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
  @@map("student_invoices")
}

model PaymentTransaction {
  id             Int            @id @default(autoincrement())
  tenantId       Int
  invoiceId      Int
  invoice        StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptNumber  String         // RCP-2026-XXXXX
  amountPaid     Float
  paymentMethod  String         @default("BANK_TRANSFER") // STRIPE, PAYPAL, BANK_TRANSFER, CASH, CHEQUE
  transactionRef String?
  gatewayStatus  String         @default("SUCCESS") // SUCCESS, PENDING, FAILED, REFUNDED
  paidAt         DateTime       @default(now())
  receivedById   Int?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([gatewayStatus])
  @@map("payment_transactions")
}

model SchoolExpense {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  expenseNumber String   // EXP-2026-XXXXX
  category      String   // UTILITIES, FACILITIES, PAYROLL, LAB_SUPPLIES, TECHNOLOGY, MARKETING, TRANSPORT
  title         String
  amount        Float
  currency      String   @default("USD")
  vendorName    String?
  paymentStatus String   @default("PAID") // PAID, PENDING, APPROVED
  incurredAt    DateTime @default(now())
  recordedById  Int?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  @@unique([tenantId, expenseNumber])
  @@index([tenantId])
  @@index([category])
  @@index([paymentStatus])
  @@map("school_expenses")
}

// ==================================================
// COMMUNICATION, MESSAGING & CHAT ENGINE (BOX 13)
// ==================================================

model ChatChannel {
  id          Int             @id @default(autoincrement())
  tenantId    Int
  channelCode String          // GEN-ANNOUNCEMENTS, FACULTY-LOUNGE, CLASS-10A, DM-1-4
  name        String
  type        String          @default("GROUP") // DIRECT, GROUP, ANNOUNCEMENT, CLASS
  description String?
  createdById Int?
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ChannelMember[]
  messages    ChatMessage[]

  @@unique([tenantId, channelCode])
  @@index([tenantId])
  @@index([type])
  @@map("chat_channels")
}

model ChannelMember {
  id         Int         @id @default(autoincrement())
  tenantId   Int
  channelId  Int
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     Int
  role       String      @default("MEMBER") // ADMIN, MODERATOR, MEMBER
  lastReadAt DateTime?
  joinedAt   DateTime    @default(now())
  createdAt  DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("channel_members")
}

model ChatMessage {
  id              Int         @id @default(autoincrement())
  tenantId        Int
  channelId       Int
  channel         ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId        Int
  senderName      String?
  senderRole      String?
  messageType     String      @default("TEXT") // TEXT, ANNOUNCEMENT, FILE, EMERGENCY_ALERT
  content         String      @db.Text
  attachmentUrl   String?
  priority        String      @default("NORMAL") // NORMAL, HIGH, URGENT
  isDeleted       Boolean     @default(false)
  smsDispatched   Boolean     @default(false)
  emailDispatched Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId])
  @@index([channelId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_messages")
}

model BroadcastAnnouncement {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  title          String
  content        String   @db.Text
  category       String   @default("GENERAL") // GENERAL, ACADEMIC, EMERGENCY, EVENT, ADMINISTRATIVE
  priority       String   @default("NORMAL") // NORMAL, HIGH, EMERGENCY
  targetAudience String   @default("ALL") // ALL, TEACHERS, PARENTS, STUDENTS, STAFF
  publishedById  Int?
  isPublished    Boolean  @default(true)
  publishedAt    DateTime @default(now())
  smsSentCount   Int      @default(0)
  emailSentCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([priority])
  @@index([targetAudience])
  @@map("broadcast_announcements")
}

