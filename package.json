{
  "name": "gbs-system",
  "version": "1.0.0",
  "description": "GBS Enterprise Ecosystem - Unified Monorepo Orchestration",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "npm run start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run prisma:generate --prefix backend",
    "build": "npm run prisma:generate --prefix backend && npm run build --prefix frontend"
  },
  "keywords": [
    "gbs",
    "enterprise",
    "school-management",
    "monorepo",
    "saas"
  ],
  "author": "GBS SYSTEM",
  "license": "ISC"
}
